# Copy to .env.local and fill in. .env.local is git-ignored.
# Claude: leave empty to use your local `claude` login.
ANTHROPIC_API_KEY=
# OpenAI adapter (required) and Codex (optional; or run `pnpm exec codex login`).
OPENAI_API_KEY=
# Leave empty. `pnpm dev:demo` sets these to the made-up demo configs.
MOTHERSHIP_MCP_CONFIG=
MOTHERSHIP_DASHBOARD_CONFIG=
# Folder sessions work in when you leave it empty and choose none in Settings. Defaults to your home folder.
MOTHERSHIP_WORKSPACE=

LINEAR_API_KEY=
NUCLINO_API_KEY=
# User token (xoxp-) from your internal Slack app install.
SLACK_USER_TOKEN=
# Absolute path to the OAuth client JSON downloaded from Google Cloud.
GOOGLE_OAUTH_CREDENTIALS=
